{
  "name": "plc-generator-pro",
  "version": "3.0.0",
  "description": "Generador de código PLC multiplataforma - 35+ marcas industriales (Windows, iOS, Android)",
  "main": "electron/main.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/ tests/",
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --linux"
  },
  "keywords": [
    "plc",
    "generator",
    "allen-bradley",
    "siemens",
    "mitsubishi",
    "omron",
    "schneider",
    "abb",
    "beckhoff",
    "industrial",
    "automation"
  ],
  "author": "Darkusbymaster",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "build": {
    "appId": "com.darkusbymaster.plcgenerator",
    "productName": "PLC Code Generator Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "src/**/*",
      "electron/**/*",
      "icons/**/*",
      "manifest.json",
      "sw.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icons/icon-512.png",
      "uninstallerIcon": "icons/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/icon-512.png"
    }
  }
}
